---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { OFFICES, fmtDate, getRaces, raceLabel, raceUrl, slugOf, url } from '../../lib';

export async function getStaticPaths() {
  const races = await getRaces();
  const bySlug = new Map(races.map((r) => [slugOf(r), r]));
  for (const race of races) {
    for (const other of race.data.related) {
      const target = bySlug.get(other);
      if (!target) throw new Error(`${race.id}: related race "${other}" does not exist`);
      if (!target.data.related.includes(slugOf(race)))
        throw new Error(`${race.id} lists "${other}" as related, but not vice versa`);
    }
  }
  return races.map((race) => ({
    params: { office: race.data.office, slug: slugOf(race) },
    props: { race },
  }));
}
const { race } = Astro.props;
const all = await getRaces();
const related = race.data.related
  .map((slug) => all.find((r) => slugOf(r) === slug)!)
  .sort((a, b) => raceLabel(a).localeCompare(raceLabel(b)));
const { Content, headings } = await render(race);
const sections = headings.filter((h) => h.depth === 2);
const { data } = race;
---
<Base title={`${raceLabel(race)}: ${data.title}`} description={data.summary}>
  <p class="meta"><a href={url(`${data.office}/`)}>← {OFFICES[data.office]}</a></p>
  <h1>{raceLabel(race)}: {data.title}</h1>
  <p class="meta">Briefing of {fmtDate(data.briefingDate)} · Election Day {fmtDate(data.electionDate)}</p>
  {Object.keys(data.ratings).length > 0 && (
    <section class="ratings" aria-label="Forecaster ratings">
      <h2>Forecaster ratings <span class="asof">as of {fmtDate(data.briefingDate)}</span></h2>
      <dl>
        {Object.entries(data.ratings).map(([who, rating]) => (
          <><dt>{who}</dt><dd>{rating}</dd></>
        ))}
      </dl>
    </section>
  )}
  {sections.length > 1 && (
    <nav class="toc" aria-label="On this page">
      <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
  )}
  <article><Content /></article>
  {related.length > 0 && (
    <section class="related">
      <h2>Related races</h2>
      <ul>
        {related.map((r) => <li><a href={raceUrl(r)}>{raceLabel(r)}</a>: {r.data.title}</li>)}
      </ul>
    </section>
  )}
</Base>

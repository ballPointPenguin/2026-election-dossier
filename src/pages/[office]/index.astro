---
import Base from '../../layouts/Base.astro';
import RaceBrowser from '../../components/RaceBrowser.astro';
import { OFFICES, getRaces, type Office } from '../../lib';

export function getStaticPaths() {
  return (Object.keys(OFFICES) as Office[]).map((office) => ({ params: { office } }));
}
const office = Astro.params.office as Office;
const races = await getRaces(office);
---
<Base title={`${OFFICES[office]} · 2026 Election Dossier`}>
  <h1>{OFFICES[office]}</h1>
  {races.length > 0 ? <RaceBrowser races={races} id={`${office}-table`} /> : <p class="meta">No races yet.</p>}
</Base>
